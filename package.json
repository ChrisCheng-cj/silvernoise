{
  "name": "silver-noise-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "cf:configure": "node scripts/cloudflare-config.mjs",
    "cf:deploy": "wrangler d1 migrations apply silvernoise-content --remote --config .cloudflare/wrangler.json && wrangler deploy --config .cloudflare/wrangler.json",
    "test:cloudflare": "node --test tests/cloudflare-auth.test.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "wrangler": "4.92.0"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "packageManager": "pnpm@11.25.0"
}
